# Choose: openrouter, xai, or none (local discovery/scanning only)
BUGFINDER_PROVIDER=openrouter

# Paste only the key for the selected provider.

BUGFINDER_API_KEY=your_openrouter_api_key_here

# Free models change over time; set one currently available to your account.
BUGFINDER_MODEL=openrouter/free

# Optional overrides
# BUGFINDER_BASE_URL=https://openrouter.ai/api/v1
# GITHUB_TOKEN=github_pat_for_higher_search_limits
# BUGFINDER_MAX_FILE_BYTES=200000
